<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="<%= meta.description %>" />
  <title><%= meta.title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>

<div class="progress" aria-hidden="true"></div>

<%- include('partials/header') %>

<main>

  <button class="back-to-top" aria-label="Back to top">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
  </button>

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="hero section" id="home">
    <div class="hero-copy">
      <p class="eyebrow"><span></span> Available for opportunities</p>
      <h1>Turning data<br>into <strong>decisions.</strong></h1>
      <p class="lead">
        I'm Bereket — a Data Analyst and aspiring AI Engineer from Addis Ababa.
        I build machine learning pipelines, automate insights, and turn messy datasets
        into products people can use.
      </p>
      <p class="typing-line" aria-hidden="true">
        <span class="typing-text"></span><span class="typing-cursor">|</span>
      </p>
      <div class="hero-actions">
        <a class="button primary" href="#projects">
          View projects
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="button secondary" href="#contact">
          Get in touch
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4zM4 7l8 6 8-6"/></svg>
        </a>
        <a class="button secondary" href="<%= profile.github %>" target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          GitHub
        </a>
      </div>
    </div>

    <div class="hero-visual profile-visual" aria-label="<%= profile.name %> profile card">
      <div class="profile-frame">
        <span class="corner corner-top"></span>
        <span class="corner corner-bottom"></span>
        <img src="<%= profile.image %>" alt="Portrait of <%= profile.name %>" />
        <div class="profile-label"><%= profile.name %></div>
        <div class="profile-open"><span></span> <%= profile.location %></div>
        <div class="badge badge-years"><span></span> CS Graduate</div>
        <div class="badge badge-projects"><span></span> <%= projects.length %> Projects</div>
      </div>
      <div class="availability-pill">
        <span></span> Open to new opportunities
      </div>
    </div>
  </section>

  <!-- ── About ─────────────────────────────────────────────── -->
  <section class="section about-grid" id="about">
    <div class="reveal">
      <p class="section-kicker">About</p>
      <h2>Building toward world-class AI engineering — one dataset at a time.</h2>
    </div>
    <div class="about-content reveal reveal-delay-1">
      <p>
        I'm a Computer Science graduate from Ambo University with a deep passion for Data Science,
        Machine Learning, and Artificial Intelligence. My work centers on transforming raw, messy data
        into clean pipelines, meaningful insights, and practical ML products.
      </p>
      <p>
        From NLP classifiers and fraud detection systems to credit-risk models and time series forecasting,
        I build end-to-end solutions using Python, Scikit-learn, XGBoost, and SQL. My goal is to become
        a production-ready AI Engineer who ships things that create real-world impact.
      </p>
      <div class="metric-row">
        <div><b>2016</b><span>Graduated E.C.</span></div>
        <div><b><%= projects.length %></b><span>Projects built</span></div>
        <div><b><%= services.length %></b><span>Service areas</span></div>
      </div>
    </div>
  </section>

  <!-- ── Skills ────────────────────────────────────────────── -->
  <section class="section" id="skills">
    <p class="section-kicker reveal">Skills</p>
    <div class="section-heading reveal reveal-delay-1">
      <h2>Technical toolkit.</h2>
      <p>Languages, frameworks, and tools I use to go from raw data to working ML products.</p>
    </div>
    <div class="skills-grid">
      <% skills.forEach((group, i) => { %>
      <article class="reveal" style="transition-delay: <%= i * 0.07 %>s">
        <h3><%= group.title %></h3>
        <ul>
          <% group.items.forEach(item => { %>
          <li><%= item %></li>
          <% }) %>
        </ul>
      </article>
      <% }) %>
    </div>
  </section>

  <!-- ── Projects ──────────────────────────────────────────── -->
  <section class="section" id="projects">
    <p class="section-kicker reveal">Projects</p>
    <div class="section-heading reveal reveal-delay-1">
      <h2>Selected projects.</h2>
      <p>Applied ML, analytics, scraping, and dashboard work — each one a full end-to-end pipeline.</p>
      <span class="project-count-badge"><%= projects.length %> projects</span>
    </div>
    <div class="project-list">
      <% projects.forEach((p, i) => { %>
      <article class="project-card reveal" style="transition-delay: <%= i * 0.06 %>s">
        <div class="project-meta">
          <span class="project-num"><%= p.num %></span>
          <span class="project-sep">—</span>
          <%= p.category %>
          <% if (p.stars > 0) { %>
            <span class="project-stars">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <%= p.stars %>
            </span>
          <% } %>
        </div>
        <h3><%= p.title %></h3>
        <p><%= p.desc %></p>
        <div class="tags">
          <% if (p.lang) { %><span class="tag-lang"><%= p.lang %></span><% } %>
          <% p.tags.forEach(tag => { %><span><%= tag %></span><% }) %>
        </div>
        <div class="project-links">
          <a href="<%= p.github %>" target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
            View on GitHub
          </a>
          <a href="#contact">Request demo</a>
        </div>
      </article>
      <% }) %>
    </div>
  </section>

  <!-- ── Experience ────────────────────────────────────────── -->
  <section class="section experience" id="experience">
    <p class="section-kicker reveal">Experience</p>
    <div class="section-heading reveal reveal-delay-1">
      <h2>Education &amp; experience.</h2>
      <p>A foundation in computer science, hands-on IT support, and self-directed ML engineering.</p>
    </div>
    <div class="timeline">
      <% experience.forEach((e, i) => { %>
      <article class="reveal" style="transition-delay: <%= i * 0.1 %>s">
        <p class="date"><%= e.org %></p>
        <% if (e.period) { %><p class="period"><%= e.period %></p><% } %>
        <h3><%= e.role %></h3>
        <p><%= e.desc %></p>
      </article>
      <% }) %>
    </div>
  </section>

  <!-- ── Services ──────────────────────────────────────────── -->
  <section class="section" id="services">
    <p class="section-kicker reveal">Services</p>
    <div class="section-heading reveal reveal-delay-1">
      <h2>What I can help with.</h2>
      <p>Practical data services for teams, startups, students, and small businesses.</p>
    </div>
    <div class="skills-grid services-grid">
      <% services.forEach((s, i) => { %>
      <article class="reveal" style="transition-delay: <%= i * 0.06 %>s">
        <% if (s.icon) { %><span class="service-icon"><%= s.icon %></span><% } %>
        <h3><%= s.title %></h3>
        <p><%= s.desc %></p>
      </article>
      <% }) %>
    </div>
  </section>

  <!-- ── Quote ─────────────────────────────────────────────── -->
  <section class="section endorsement">
    <p class="section-kicker reveal">Mission</p>
    <blockquote class="reveal reveal-delay-1">
      My goal is to become a world-class AI Engineer while building intelligent
      applications that create real impact in the world.
    </blockquote>
  </section>

  <!-- ── Contact ───────────────────────────────────────────── -->
  <section class="section contact-section" id="contact">
    <div class="reveal">
      <p class="section-kicker">Contact</p>
      <h2>Let&rsquo;s work together.</h2>
      <p>
        Based in <%= profile.location %>. Open to data analysis, ML engineering,
        Python development, dashboard, and AI application opportunities.
      </p>
      <div class="contact-panel">
        <a href="mailto:<%= profile.email %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4zM4 7l8 6 8-6"/></svg>
          <%= profile.email %>
        </a>
        <a href="tel:<%= profile.phone.replace(/\s/g,'') %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 3.08 4.18 2 2 0 0 1 5.07 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L9.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 23 16.92z"/></svg>
          <%= profile.phone %>
        </a>
        <a href="<%= profile.github %>" target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          github.com/bereket5185
        </a>
        <a href="<%= profile.linkedin %>" target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
          linkedin.com/in/bereket-gebrealif
        </a>
      </div>
    </div>

    <div class="reveal reveal-delay-1">
      <% if (flash) { %>
      <div class="flash <%= flash.type %>"><%= flash.text %></div>
      <% } %>
      <form class="contact-form" method="POST" action="/contact">
        <input  type="text"  name="name"    placeholder="Your name"    required autocomplete="name" />
        <input  type="email" name="email"   placeholder="Your email"   required autocomplete="email" />
        <textarea            name="message" placeholder="Your message" required></textarea>
        <button type="submit">
          Send message
          <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" style="display:inline-block;vertical-align:middle;margin-left:6px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/></svg>
        </button>
      </form>
    </div>
  </section>

</main>

<%- include('partials/footer') %>

<script src="/script.js"></script>
</body>
</html>
